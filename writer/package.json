{
  "name": "tiffin-writer",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && SINGLEFILE=1 vite build --outDir dist-single && mv dist-single/index.html dist-single/Tiffin_Writer.tiffin.html && node ../scripts/postbuild-compress.mjs dist-single/Tiffin_Writer.tiffin.html && node ../scripts/shell-gate.mjs dist-single/Tiffin_Writer.tiffin.html",
    "gate": "node ../scripts/shell-gate.mjs dist-single/Tiffin_Writer.tiffin.html",
    "test": "esbuild test/review.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/tf-test.mjs --log-level=error && node node_modules/.cache/tf-test.mjs"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.3",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.7.1",
    "prosemirror-view": "^1.42.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
